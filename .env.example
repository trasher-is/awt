# Copy to .env (which is gitignored) and fill in. Everything here has a working
# default except DISCORD_TOKEN, so an unconfigured checkout still boots.
#
# A few variables only take effect once their matching change is merged; they are
# marked below.

# --- Core ---
PORT=3000

# Signs session cookies. If left empty the server generates one on first boot and
# stores it in .session-secret (gitignored). Set it explicitly to keep sessions valid
# across a rebuild or to share one secret between machines.
SESSION_SECRET=

# Public hostname the hub is served from, no scheme. Used to build absolute links in
# Discord messages and to point the redzone userscript at this host.
PROXY_DOMAIN=

# Upstream game servers.
TARGET_URL=https://astrowars.games
REDZONE_TARGET_URL=https://redzone.astrowars.games

# Where the /rz shortcut redirects. Defaults to the current production host.
RZ_PUBLIC_URL=

# --- Discord ---
DISCORD_TOKEN=

# Optional second bot, purely for a distinct avatar/identity on battle-leaderboard posts
# (!mortal/!mortalday/!mortalweek replies still come from the main bot above). Leave empty
# to have battle posts go out through DISCORD_TOKEN instead — nothing is silenced.
BATTLE_DISCORD_TOKEN=

# --- Security / deployment ---
# 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare) so req.ip is the
# real client. Set to 0 only if Node is exposed directly on the public port.
TRUST_PROXY=1

# Session cookie Secure flag. Left blank it is 'auto': the flag is set whenever the
# request is seen as HTTPS, which behind a proxy requires X-Forwarded-Proto (see the
# reverse-proxy section in README.md — without that header logins cannot persist).
# true forces it on, false forces it off for a deliberately plain-HTTP hub.
COOKIE_SECURE=

# Password for the shared redzone planner (/rzhub). The committed default is public —
# set this to actually rotate it. Changing it also invalidates every unlock cookie.
RZ_PASSWORD=

# Shared secret the in-game notification forwarder must send as the X-Webhook-Token
# header. Leave empty to keep the endpoint open (a warning is logged on every call).
# [takes effect with the proxy/webhook change]
WEBHOOK_TOKEN=

# --- Rate limits (max requests per window; 0 disables that limiter) ---
LOGIN_MAX=15          # per 15 min, hub login
RZ_LOGIN_MAX=20       # per 15 min, redzone planner password
WEBHOOK_MAX=30        # per minute, game-notification webhook
RZ_PROXY_MAX=900      # per minute, open redzone proxy (one page = dozens of assets)
PROXY_MAX=900         # per minute, per member, ceiling on ALL proxied game traffic

# Per-member gate on marker-tagged scraper traffic to the game. These two wait (queue)
# at the limit instead of failing; the *_WAIT_MS value is how long a queued request may
# wait before it answers 429.
GAME_MAX_PER_SECOND=5
GAME_MAX_WAIT_MS=8000

# Whole-hub budget for the game's REST API (/api/v1/*): five requests per second for
# every member and feature COMBINED, by agreement with the game's administrator.
# Raising it requires their renewed consent, not a config change. Same queue-then-429
# semantics as the pair above.
GAME_API_MAX_PER_SECOND=5
GAME_API_MAX_WAIT_MS=8000

# --- Admin log viewer ---
# Absolute path to the pm2 error log surfaced in the admin panel. Overrides the
# logPath entry in config.json. [takes effect with the routes/authorization change]
LOG_PATH=/root/.pm2/logs/awt-error.log

# --- Dev only ---
# NODE_ENV=development
# IS_TEST_SERVER=true
