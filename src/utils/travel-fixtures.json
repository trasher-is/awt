{
  "_readme": [
    "Ground truth for the fleet travel-time formula. Every entry is a time the game itself",
    "displayed. Never edit a number here to make a test pass.",
    "",
    "Two ways to add entries:",
    "  measured  — read off a fleet deployment screen by hand (the original nine)",
    "  api       — generated by scripts/collect-travel-fixtures.js against the test server's",
    "              GET /api/v1/Fleet/travelTime, which is the game's own calculation",
    "",
    "The gate is EXACT: zero seconds of error. See docs/travel-calibration.md."
  ],

  "gate": {
    "maxErrorSeconds": 0,
    "_note": "The formula reproduces every measurement below to the second, so the gate demands exactness rather than a percentage. If a new fixture breaks it, fix the formula — do not loosen this."
  },

  "cases": [
    {
      "desc": "same system, planet 1 -> 6, energy 9, speed +4",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 6],
      "energy": 9, "speed": 4, "alliance": false,
      "expect": "03:14:42"
    },
    {
      "desc": "same system, planet 1 -> 12, energy 15, speed -2",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 12],
      "energy": 15, "speed": -2, "alliance": false,
      "expect": "04:39:01"
    },
    {
      "desc": "same system, planet 1 -> 12, energy 27, speed -4",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 12],
      "energy": 27, "speed": -4, "alliance": false,
      "expect": "02:16:20"
    },
    {
      "desc": "same system, planet 1 -> 2, energy 0, speed 0",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 2],
      "energy": 0, "speed": 0, "alliance": false,
      "expect": "05:59:24"
    },
    {
      "desc": "same system, planet 1 -> 3, energy 0, speed 0",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 3],
      "energy": 0, "speed": 0, "alliance": false,
      "expect": "07:15:41"
    },
    {
      "desc": "same system, planet 1 -> 12, energy 0, speed 0",
      "source": "measured",
      "from": [100, 200, 1], "to": [100, 200, 12],
      "energy": 0, "speed": 0, "alliance": false,
      "expect": "14:11:23"
    },
    {
      "desc": "deep space, energy 8, speed +2 (long haul, 112 hours)",
      "source": "measured",
      "from": [-20, -22, 1], "to": [-6, 3, 6],
      "energy": 8, "speed": 2, "alliance": false,
      "expect": "112:08:18"
    },
    {
      "desc": "deep space, energy 25, speed +1, allied move (halved)",
      "source": "measured",
      "from": [-4, -1, 4], "to": [-2, -8, 10],
      "energy": 25, "speed": 1, "alliance": true,
      "expect": "03:35:27"
    },
    {
      "desc": "deep space, energy 45, speed +4",
      "source": "measured",
      "from": [0, 0, 1], "to": [22, 15, 12],
      "energy": 45, "speed": 4, "alliance": false,
      "expect": "03:26:16"
    }
  ]
}
